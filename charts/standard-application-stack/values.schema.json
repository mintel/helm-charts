    "imagePullSecrets": { "type": "array" },

    "port": { "type": ["integer", "null"] },
    "extraPorts": { "type": "array" },
    "command": { "type": ["array", "null"] },
    "args": { "type": ["array", "null"] },
    "env": { "type": "array" },
